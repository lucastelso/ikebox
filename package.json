{
  "name": "ipsec-client",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente de VPN IPsec para Linux, focado em VPNs legadas (IKEv1, PSK de grupo + XAuth)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "npm run check:private && npm run lint:sh && npm run check:rust",
    "check:private": "scripts/check-private.sh --tracked",
    "lint:sh": "scripts/lint-sh.sh",
    "test:engine": "tests/engine/e2e.sh",
    "check:rust": "scripts/check-rust.sh",
    "test:docker": "scripts/check-rust.sh --docker-tests",
    "test:cli": "tests/cli/e2e.sh",
    "build:engine": "native-engine/build.sh",
    "test:native": "native-engine/build.sh && native-engine/spike/run-e2e.sh \"$(grep -vE '^\\s*(#|$)' native-engine/versions.txt | head -n 1 | cut -d' ' -f1)\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2"
  }
}
