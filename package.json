{
  "name": "ipsec-client",
  "version": "0.6.0",
  "private": true,
  "description": "IPsec VPN client for Linux, focused on legacy VPNs (IKEv1, group PSK + XAuth)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "npm run check:private && npm run lint:sh && npm run test:updown && npm run lint:web && npm run typecheck && npm run test:web && npm run check:rust",
    "check:private": "scripts/check-private.sh --tracked",
    "lint:sh": "scripts/lint-sh.sh",
    "test:engine": "tests/engine/e2e.sh",
    "test:updown": "tests/engine/updown-test.sh",
    "check:rust": "scripts/check-rust.sh",
    "test:docker": "scripts/check-rust.sh --docker-tests",
    "test:cli": "tests/cli/e2e.sh",
    "build:engine": "native-engine/build.sh",
    "stage:component": "scripts/stage-network-component.sh",
    "test:packaging": "tests/packaging/install-test.sh",
    "test:systemd": "tests/systemd/run.sh",
    "test:modes": "tests/modes/run.sh",
    "test:compat": "tests/compat/run.sh",
    "test:native": "native-engine/build.sh && native-engine/spike/run-e2e.sh \"$(grep -vE '^\\s*(#|$)' native-engine/versions.txt | head -n 1 | cut -d' ' -f1)\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "bundle": "tauri build --config src-tauri/tauri.release.conf.json",
    "release:build": "scripts/build-release.sh",
    "release:verify": "scripts/verify-release.sh",
    "tauri": "tauri",
    "dev:app": "tauri dev --features docker",
    "lint:web": "biome check",
    "typecheck": "tsc",
    "test:web": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  }
}
