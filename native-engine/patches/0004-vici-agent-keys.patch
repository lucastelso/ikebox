+/**
+ * Ikebox (ADR-0029): is this an RFC 7427 ECDSA scheme (DER-encoded
+ * signature) whose hash matches what the agent uses for the key's curve?
+ */
+static bool ecdsa_der_scheme_matches(private_agent_private_key_t *this,
+									 signature_scheme_t scheme)
+{
+	int size = this->pubkey->get_keysize(this->pubkey);
+
+	return (scheme == SIGN_ECDSA_WITH_SHA256_DER && size == 256) ||
+		   (scheme == SIGN_ECDSA_WITH_SHA384_DER && size == 384) ||
+		   (scheme == SIGN_ECDSA_WITH_SHA512_DER && size == 521);
+}
