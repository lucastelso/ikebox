+/**
+ * Ikebox (ADR-0029): a private key held by an ssh-agent, the person's
+ * process that has the smartcard or token. The VICI client sends only the
+ * public key (PEM); the agent socket is the one root configured in
+ * charon.plugins.vici.force_agent_socket, never one the client names. Without
+ * that option, agent keys are refused.
+ */
+static private_key_t *load_agent_key(chunk_t data, char **error)
+{
+	public_key_t *public;
+	private_key_t *key;
+	char *path;
+
+	path = lib->settings->get_str(lib->settings,
+								  "%s.plugins.vici.force_agent_socket", NULL,
+								  lib->ns);
+	if (!path || !*path)
+	{
+		*error = "agent keys are not enabled";
+		return NULL;
+	}
+	public = lib->creds->create(lib->creds, CRED_PUBLIC_KEY, KEY_ANY,
+								BUILD_BLOB_PEM, data, BUILD_END);
+	if (!public)
+	{
+		*error = "parsing the public key of the agent key failed";
+		return NULL;
+	}
+	key = lib->creds->create(lib->creds, CRED_PRIVATE_KEY,
+							 public->get_type(public),
+							 BUILD_AGENT_SOCKET, path,
+							 BUILD_PUBLIC_KEY, public, BUILD_END);
+	public->destroy(public);
+	if (!key)
+	{
+		*error = "the key agent does not hold that key";
+	}
+	return key;
+}
