# Ikebox: socket of the privileged helper (ADR-0014).
# Any user can connect; the helper decides who may act
# (SO_PEERCRED + polkit).
[Unit]
Description=Ikebox - network component socket

[Socket]
ListenStream=/run/ikebox-helper.sock
SocketMode=0666
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
