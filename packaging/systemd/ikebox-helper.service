# Ikebox: privileged helper (ADR-0014). Socket activated.
# It only validates requests and calls systemd-run/systemctl/journalctl; the
# engine runs in a transient unit with its own sandbox (see crates/helper).
[Unit]
Description=Ikebox - network component
Requires=ikebox-helper.socket
After=ikebox-helper.socket

[Service]
Type=simple
ExecStart=/opt/ikebox/bin/ikebox-helper
# /run/ikebox: per-user VICI socket directories (kept when the helper
# restarts, so an active session does not drop).
RuntimeDirectory=ikebox
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# No capability at all: the helper only talks to systemd, polkit and the
# journal as root, and touches files that root already owns.
CapabilityBoundingSet=
NoNewPrivileges=yes
# No core dumps: a crash must not write memory to disk.
LimitCORE=0
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ProtectKernelLogs=yes
UMask=0077
# The helper and what it runs (systemd-run, systemctl, journalctl) need no
# more than an ordinary service does.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
