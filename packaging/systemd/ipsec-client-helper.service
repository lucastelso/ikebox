# IPsec Client: privileged helper (ADR-0014). Socket activated.
# It only validates requests and calls systemd-run/systemctl/journalctl; the
# engine runs in a transient unit with its own sandbox (see crates/helper).
[Unit]
Description=IPsec Client - network component
Requires=ipsec-client-helper.socket
After=ipsec-client-helper.socket

[Service]
Type=simple
ExecStart=/opt/ipsec-client/bin/ipsec-client-helper
# /run/ipsec-client: per-user VICI socket directories (kept when the helper
# restarts, so an active session does not drop).
RuntimeDirectory=ipsec-client
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
# No core dumps: a crash must not write memory to disk.
LimitCORE=0
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
