<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Ikebox (ADR-0014): the user of the active local session connects
     and disconnects without a password; remote or inactive sessions do not. -->
<policyconfig>
  <vendor>Ikebox</vendor>
  <action id="io.github.lucastelso.ikebox.connect">
    <description>Connect and disconnect IPsec VPNs</description>
    <description xml:lang="pt_BR">Conectar e desconectar VPNs IPsec</description>
    <message>Authentication is required to control IPsec VPNs</message>
    <message xml:lang="pt_BR">É preciso autenticar para controlar VPNs IPsec</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
