{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ipsec-client",
  "mainBinaryName": "ipsec-client",
  "version": "0.1.1",
  "identifier": "io.github.lucastelso.ipsecclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IPsec Client",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Cliente de VPN IPsec para Linux",
    "longDescription": "Conecta a VPNs IPsec, inclusive as legadas (IKEv1, PSK de grupo + XAuth), sem configurar nada no sistema.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "IPsec Client contributors",
    "publisher": "IPsec Client contributors",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/ipsec-client.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/ipsec-client.desktop"
      }
    }
  }
}
