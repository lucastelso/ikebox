{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ikebox",
  "mainBinaryName": "ikebox",
  "version": "1.0.0",
  "identifier": "io.github.lucastelso.ikebox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ikebox",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Sandboxed IPsec VPN client for Linux (legacy IKEv1 & IKEv2)",
    "longDescription": "Connects to IPsec VPNs, including legacy ones (IKEv1, group PSK + XAuth), with strongSwan running in an isolated sandbox and nothing to configure in the system.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Ikebox contributors",
    "publisher": "Ikebox contributors",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/ikebox.desktop",
        "depends": [
          "libdbus-1-3",
          "pkexec",
          "iproute2",
          "systemd",
          "util-linux"
        ],
        "conflicts": [
          "ipsec-client"
        ],
        "replaces": [
          "ipsec-client"
        ],
        "postInstallScript": "../packaging/package/postinst.sh",
        "preRemoveScript": "../packaging/package/prerm.sh"
      },
      "rpm": {
        "desktopTemplate": "linux/ikebox.desktop",
        "depends": [
          "libdbus-1.so.3()(64bit)",
          "/usr/bin/pkexec",
          "iproute",
          "systemd",
          "findutils",
          "gawk",
          "tar",
          "gzip",
          "/usr/bin/setpriv"
        ],
        "obsoletes": [
          "ipsec-client"
        ],
        "postInstallScript": "../packaging/package/postinst.sh",
        "preRemoveScript": "../packaging/package/prerm.sh"
      }
    }
  }
}
