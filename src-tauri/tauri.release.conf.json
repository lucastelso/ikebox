{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && scripts/stage-network-component.sh && scripts/stage-cli.sh && scripts/stage-licenses.sh"
  },
  "bundle": {
    "resources": {
      "../target/network-component": "network",
      "../target/licenses": "licenses"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/ikebox-cli": "../target/cli-assets/ikebox-cli",
          "/usr/share/man/man1/ikebox-cli.1.gz": "../target/cli-assets/ikebox-cli.1.gz",
          "/usr/share/bash-completion/completions/ikebox-cli": "../target/cli-assets/ikebox-cli.bash",
          "/usr/share/fish/vendor_completions.d/ikebox-cli.fish": "../target/cli-assets/ikebox-cli.fish",
          "/usr/share/zsh/vendor-completions/_ikebox-cli": "../target/cli-assets/_ikebox-cli",
          "/usr/share/metainfo/io.github.lucastelso.ikebox.metainfo.xml": "linux/io.github.lucastelso.ikebox.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/ikebox-cli": "../target/cli-assets/ikebox-cli",
          "/usr/share/man/man1/ikebox-cli.1.gz": "../target/cli-assets/ikebox-cli.1.gz",
          "/usr/share/bash-completion/completions/ikebox-cli": "../target/cli-assets/ikebox-cli.bash",
          "/usr/share/fish/vendor_completions.d/ikebox-cli.fish": "../target/cli-assets/ikebox-cli.fish",
          "/usr/share/zsh/site-functions/_ikebox-cli": "../target/cli-assets/_ikebox-cli",
          "/usr/share/metainfo/io.github.lucastelso.ikebox.metainfo.xml": "linux/io.github.lucastelso.ikebox.metainfo.xml"
        }
      }
    }
  }
}
