# ---------------------------------------------------------------------------
# Local and private data — NEVER commit
# ---------------------------------------------------------------------------
# Profiles with real data of your organization (gateway, group, internal DNS...).
/presets.local/
*.local.json
# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
# Public, fake test CA certificates (never keys: a test in profiles/ca.rs
# checks that none of them holds a private key).
!crates/core/tests/fixtures/ca/*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
/target/
/src-tauri/target/
/src-tauri/gen/schemas/
node_modules/
/dist/
/coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Editors and system
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*~
.DS_Store
.claude/settings.local.json

# Test logs and artifacts
*.log
__pycache__/
trabalho.json

# Embedded engine artifacts (built by native-engine/build.sh)
/native-engine/dist/
