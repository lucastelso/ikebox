---
source: crates/core/src/profiles/mod.rs
expression: text
---
remote_addrs = [vpn.example.com]
version = 1
aggressive = yes
encap = yes
proposals = [aes256-sha1-modp1024, aes128-sha1-modp1024]
rekey_time = 86400s
dpd_delay = 30s
vips = [0.0.0.0]
local-1 {
    auth = psk
    id = keyid:group-name
}
local-2 {
    auth = xauth
    xauth_id = usuario.exemplo
}
remote {
    auth = psk
}
children {
    internal-network {
        remote_ts = [192.0.2.0/24]
        esp_proposals = [aes256-sha1-modp1024, aes256-sha1-modp768, aes128-sha1-modp1024]
        start_action = none
        dpd_action = restart
        close_action = restart
        if_id_in = 1486177937
        if_id_out = 1486177937
        updown = /usr/local/libexec/ikebox/updown --iface 'ipsc0' --dns '192.0.2.53' --domain '~corp.example.com'
        rekey_time = 43200s
    }
}
