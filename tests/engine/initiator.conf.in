# TEST connection loaded into the engine by e2e.sh (through swanctl inside
# the container). In the app, the equivalent is built from the profile and
# sent over VICI (load-conn), and the secrets go through load-shared, never
# through a file.
#
# The same shape as a typical legacy VPN: IKEv1 aggressive, group PSK (keyid)
# + XAuth, modp1024/modp768, split tunnel. FAKE credentials.
# @GATEWAY@, @IFACE@, @IF_ID@, @REMOTE_TS@ and @UPDOWN_EXTRA@ are replaced by
# e2e.sh.

connections {
    teste {
        remote_addrs = @GATEWAY@
        version = 1
        aggressive = yes
        encap = yes
        proposals = aes256-sha1-modp1024,aes128-sha1-modp1024
        rekey_time = 86400s
        dpd_delay = 30s
        vips = 0.0.0.0

        local-1 {
            auth = psk
            id = keyid:grupo-teste
        }
        local-2 {
            auth = xauth
            xauth_id = usuario.teste
        }
        remote {
            auth = psk
        }

        children {
            rede-teste {
                remote_ts = @REMOTE_TS@
                esp_proposals = aes256-sha1-modp1024,aes256-sha1-modp768,aes128-sha1-modp1024
                rekey_time = 43200s
                start_action = none
                dpd_action = restart
                close_action = start
                if_id_in = @IF_ID@
                if_id_out = @IF_ID@
                updown = /usr/local/libexec/ipsec-client/updown --iface '@IFACE@'@UPDOWN_EXTRA@
            }
        }
    }
}

secrets {
    ike-grupo-teste {
        id = keyid:grupo-teste
        secret = ipsec-client-test-psk
    }
    xauth-usuario-teste {
        id = usuario.teste
        secret = senha-de-teste
    }
}
